{
  "name": "barq-dm",
  "productName": "Barq Download Manager",
  "version": "1.3.6",
  "description": "برق — مدير تنزيلات سريع بتقطيع ديناميكي متعدد الاتصالات (Electron + Realm)",
  "main": "src/main/main.js",
  "author": "Barq",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "node test/engine.test.js && node test/manager.test.js && node test/dash.test.js && node test/ytdlp.test.js",
    "dist": "node scripts/pack-extensions.js && electron-builder",
    "dist:win": "node scripts/pack-extensions.js && electron-builder --win nsis portable --x64",
    "pack:ext": "node scripts/pack-extensions.js",
    "bench": "node test/speed.bench.js"
  },
  "dependencies": {
    "realm": "^20.1.0"
  },
  "devDependencies": {
    "electron": "^45.1.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.barq.dm",
    "productName": "Barq Download Manager",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "dist-ext",
        "to": "extensions"
      }
    ],
    "asarUnpack": [
      "node_modules/realm/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "executableName": "Barq"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Barq Download Manager",
      "artifactName": "Barq-Setup-${version}.${ext}",
      "installerLanguages": [
        "ar_SA",
        "en_US"
      ],
      "multiLanguageInstaller": true,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico",
      "uninstallDisplayName": "Barq Download Manager"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "assets/icon.png"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "assets/icon.png"
    },
    "npmRebuild": false,
    "portable": {
      "artifactName": "Barq-Portable-${version}.${ext}"
    },
    "publish": null,
    "copyright": "© 2026 Barq"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/myksa200-boop/barq-download-manager"
  }
}